<script>
// ── Quantity → update price, totals, bag badge ──
var BASE_PRICE = 25.00;

function updateQty(qty){
  qty = parseInt(qty,10);
  var total = BASE_PRICE * qty;
  var fmt = '$' + total.toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g,',');
  document.getElementById('itemPrice').textContent   = fmt;
  document.getElementById('subtotalVal').textContent = fmt;
  document.getElementById('totalVal').textContent    = fmt;
  document.getElementById('bagTotal').textContent    = fmt;
  // Update ALL badge elements
  document.querySelectorAll('#bagBadge').forEach(function(b){ b.textContent = qty; });
  // animate badge
  var badge = document.getElementById('bagBadge');
  badge.style.transform='scale(1.4)';
  setTimeout(function(){ badge.style.transform='scale(1)'; },200);
}

// ── Questions chevron toggle ──
document.getElementById('qtog').addEventListener('click',function(){
  var c = document.getElementById('qchev');
  c.style.transform = c.style.transform==='rotate(180deg)' ? '' : 'rotate(180deg)';
});

// ── Swatch selection ──
document.querySelectorAll('.swatches').forEach(function(wrap){
  wrap.querySelectorAll('.sw').forEach(function(s){
    s.addEventListener('click',function(){
      wrap.querySelectorAll('.sw').forEach(function(x){ x.classList.remove('on'); });
      s.classList.add('on');
    });
  });
});
</script>
