<script>
/* =========================================================
   1. BROWSER + PLATFORM DETECTION
   ========================================================= */
const UA = navigator.userAgent;
const uaData = navigator.userAgentData;

function detectBrowser(){
  // Edge
  if (/Edg\//.test(UA)) return 'edge';
  // Opera / OPR
  if (/OPR\//.test(UA) || /Opera/.test(UA)) return 'chrome';
  // Firefox
  if (/Firefox\/|FxiOS\//.test(UA)) return 'firefox';
  // Chrome (includes Chromium, Brave, Vivaldi etc.)
  if (/Chrome\/|CriOS\//.test(UA) && !/Edg\//.test(UA)) return 'chrome';
  // Safari (last, kyunki Safari mein bhi "Chrome" nahi hota)
  if (/Safari\//.test(UA) && !/Chrome|Chromium|CriOS/.test(UA)) return 'safari';
  // iOS WebViews
  if (/iPhone|iPad|iPod/.test(UA)) return 'safari';
  return 'chrome'; // fallback
}

function detectMobile(){
  if (/Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(UA)) return true;
  if (navigator.maxTouchPoints > 1 && /Mac/.test(UA)) return true; // iPad desktop mode
  return false;
}

function detectLightTheme(){
  return window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches;
}

const BROWSER = detectBrowser();
const IS_MOBILE = detectMobile();
const IS_LIGHT = detectLightTheme();

document.body.classList.add('theme-' + BROWSER);
if (IS_MOBILE) document.body.classList.add('mobile');
// Firefox/Chrome dark by default; Safari/Edge light by default (their OS behavior)
if (IS_LIGHT && (BROWSER === 'safari' || BROWSER === 'edge' || BROWSER === 'firefox')) {
  document.body.classList.add('theme-light');
}

/* =========================================================
