      <path d="M235 155c-6 30-26 57-58 72-30 14-68 15-97 2-29-13-50-41-50-74 0-22 10-46 34-60-30 8-47 30-47 60 0 40 30 75 76 86 34 8 72-1 100-22 22-17 38-40 42-64z" fill="url(#edg1)"/>
