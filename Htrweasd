};

function browserName(){
  return { chrome:'Chrome', firefox:'Firefox', safari:'Safari', edge:'Edge' }[BROWSER] || 'Browser';
}

/* =========================================================
   4. TAB MANAGER
   ========================================================= */
let tabs = [], activeTabId = null, tabCounter = 0;

const tabsScroll = document.getElementById('tabsScroll');
const viewport   = document.getElementById('viewport');
const urlInput   = document.getElementById('url');
const urlbar     = document.getElementById('urlbar');
const progress   = document.getElementById('progress');
const toast      = document.getElementById('toast');
const backBtn    = document.getElementById('back');
const fwdBtn     = document.getElementById('fwd');
const FAVICON_SVG = `<svg viewBox="0 0 16 16"><circle cx="8" cy="8" r="6" fill="#4285f4"/></svg>`;

function createTab(url='demo.local/welcome'){
  tabCounter++;
  const id = tabCounter;
  tabs.push({ id, url, history:[url], histIndex:0, title: titleFor(url) });
  activeTabId = id;
  renderTabs(); renderPage();
}
function titleFor(url){
  if (url.includes('features')) return 'Features';
  if (url.includes('about'))    return 'About';
  return 'Welcome';
}
function closeTab(id){
  const idx = tabs.findIndex(t=>t.id===id);
  if (idx===-1) return;
  tabs.splice(idx,1);
  if (tabs.length===0){ createTab(); return; }
  if (activeTabId===id) activeTabId = tabs[Math.max(0,idx-1)].id;
  renderTabs(); renderPage();
}
function switchTab(id){
  if (activeTabId===id) return;
  activeTabId = id; renderTabs(); renderPage();
}
function renderTabs(){
  tabsScroll.innerHTML='';
  tabs.forEach(t=>{
    const el = document.createElement('div');
    el.className = 'tab' + (t.id===activeTabId?' active':'');
    el.innerHTML = `
      <span class="favicon">${FAVICON_SVG}</span>
      <span class="title">${t.title}</span>
      <button class="close"><svg viewBox="0 0 10 10"><path d="M1 1 9 9M9 1 1 9" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg></button>`;
    el.addEventListener('click', e=>{
      if (e.target.closest('.close')) { closeTab(t.id); return; }
      switchTab(t.id);
    });
    el.addEventListener('auxclick', e=>{ if (e.button===1) closeTab(t.id); });
    tabsScroll.appendChild(el);
  });
}
function activeTab(){ return tabs.find(t=>t.id===activeTabId); }

/* =========================================================
   5. NAVIGATION
   ========================================================= */
function navigate(url, {pushHistory=true}={}){
  const tab = activeTab(); if (!tab) return;
  url = url.trim();
  if (pushHistory){
    tab.history = tab.history.slice(0, tab.histIndex+1);
    tab.history.push(url);
    tab.histIndex = tab.history.length-1;
  }
  tab.url = url; tab.title = titleFor(url);
  renderTabs(); renderPage({animate:true});
  showToast('Navigated to '+url);
}
function renderPage({animate=false}={}){
  const tab = activeTab(); if (!tab) return;
  urlInput.value = tab.url;
  const root = document.getElementById('pageRoot');
  const builder = PAGES[tab.url] || (()=>`
    <div class="page">
      <h1 style="font-size:28px">${escapeHtml(tab.url)}</h1>
      <p class="lead">Ye sirf ek visual mockup hai — koi asli navigation nahi hui.</p>
    </div>`);
  root.innerHTML = builder();
  if (animate) root.firstElementChild.style.animation = 'none';
  viewport.scrollTop = 0;
  progress.style.width = '0%';
  backBtn.disabled = tab.histIndex <= 0;
  fwdBtn.disabled  = tab.histIndex >= tab.history.length-1;
  const mbBack = document.getElementById('mbBack');
  const mbFwd  = document.getElementById('mbFwd');
  if (mbBack) mbBack.style.opacity = backBtn.disabled ? .35 : 1;
  if (mbFwd)  mbFwd.style.opacity  = fwdBtn.disabled  ? .35 : 1;
}

/* =========================================================
   6. EVENTS
   ========================================================= */
document.getElementById('newTab').addEventListener('click', ()=>createTab());

backBtn.addEventListener('click', ()=>{
  const t = activeTab();
  if (t.histIndex>0){ t.histIndex--; t.url=t.history[t.histIndex]; t.title=titleFor(t.url); renderTabs(); renderPage({animate:true}); }
});
fwdBtn.addEventListener('click', ()=>{
  const t = activeTab();
  if (t.histIndex<t.history.length-1){ t.histIndex++; t.url=t.history[t.histIndex]; t.title=titleFor(t.url); renderTabs(); renderPage({animate:true}); }
});
document.getElementById('reload').addEventListener('click', ()=>{
  const svg = document.querySelector('#reload svg');
  svg.style.transition='transform .6s cubic-bezier(.4,0,.2,1)';
  svg.style.transform='rotate(360deg)';
  setTimeout(()=>{ svg.style.transition=''; svg.style.transform=''; },620);
  progress.style.width='60%';
  setTimeout(()=>progress.style.width='100%',150);
  setTimeout(()=>progress.style.width='0%',700);
  renderPage({animate:true});
});
document.getElementById('home').addEventListener('click', ()=>navigate('demo.local/welcome'));

urlInput.addEventListener('focus', ()=>{ urlbar.classList.add('focused'); urlInput.select(); });
urlInput.addEventListener('blur',  ()=>urlbar.classList.remove('focused'));
urlInput.addEventListener('keydown', e=>{
  if (e.key!=='Enter') return;
  let v = urlInput.value.trim(); if (!v) return;
  if (!v.startsWith('demo.local')) v = 'demo.local/'+v.replace(/^https?:\/\//,'').replace(/^\/+/,'');
  navigate(v);
});

const menuBtn=document.getElementById('menuBtn');
const menuPanel=document.getElementById('menuPanel');
const bmBtn=document.getElementById('bookmarkBtn');
const bmPanel=document.getElementById('bmPanel');
menuBtn.addEventListener('click', e=>{ e.stopPropagation(); bmPanel.classList.remove('show'); menuPanel.classList.toggle('show'); });
bmBtn.addEventListener('click',   e=>{ e.stopPropagation(); menuPanel.classList.remove('show'); bmPanel.classList.toggle('show'); });
document.addEventListener('click', ()=>{ menuPanel.classList.remove('show'); bmPanel.classList.remove('show'); });

menuPanel.querySelectorAll('.panel-item').forEach(btn=>{
  btn.addEventListener('click', ()=>{
    const a = btn.dataset.action;
    if (a==='newtab') createTab();
    if (a==='newwin') showToast('New window — sirf mockup hai');
    if (a==='zoomin') showToast('Zoom in');
    if (a==='zoomout') showToast('Zoom out');
    if (a==='history') showToast('History panel');
    if (a==='about') navigate('demo.local/about');
    menuPanel.classList.remove('show');
  });
});
bmPanel.querySelectorAll('.panel-item').forEach(btn=>{
  btn.addEventListener('click', ()=>{ navigate(btn.dataset.nav); bmPanel.classList.remove('show'); });
});

viewport.addEventListener('scroll', ()=>{
  const max = viewport.scrollHeight - viewport.clientHeight;
  const pct = max>0 ? (viewport.scrollTop/max)*100 : 0;
  progress.style.width = pct+'%';
});

document.addEventListener('keydown', e=>{
  if ((e.ctrlKey||e.metaKey) && e.key.toLowerCase()==='t'){ e.preventDefault(); createTab(); }
  if ((e.ctrlKey||e.metaKey) && e.key.toLowerCase()==='w'){ e.preventDefault(); if (activeTabId) closeTab(activeTabId); }
  if ((e.ctrlKey||e.metaKey) && e.key.toLowerCase()==='r'){ e.preventDefault(); document.getElementById('reload').click(); }
  if ((e.ctrlKey||e.metaKey) && e.key.toLowerCase()==='l'){ e.preventDefault(); urlInput.focus(); }
});

/* Mobile bottom bar */
const bind = (id, fn) => { const el = document.getElementById(id); if (el) el.addEventListener('click', fn); };
bind('mbBack',  ()=>backBtn.click());
bind('mbFwd',   ()=>fwdBtn.click());
bind('mbShare', ()=>showToast('Share — mockup only'));
bind('mbTabs',  ()=>showToast('Tabs list'));
bind('mbMenu',  ()=>{ menuPanel.classList.toggle('show'); });

/* =========================================================
   7. HELPERS
   ========================================================= */
function escapeHtml(s){
  return s.replace(/[&<>"']/g, c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
}
let toastTimer;
function showToast(msg){
  toast.textContent = msg;
  toast.classList.add('show');
  clearTimeout(toastTimer);
  toastTimer = setTimeout(()=>toast.classList.remove('show'),1600);
}

/* =========================================================
   8. BOOT
   ========================================================= */
createTab('demo.local/welcome');
</script>
